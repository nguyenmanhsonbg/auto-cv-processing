{
  "name": "@interview-assistant/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:group-modal": "node --test scripts/facebook-group-modal-layout.test.mjs",
    "test:facebook-login-fast-path": "node --test scripts/facebook-login-fast-path.test.mjs",
    "test:facebook-channel-status": "tsx --test src/features/facebook/facebook-channel-status.spec.ts",
    "test:results-toggle": "node --test scripts/facebook-publish-results-toggle.test.mjs",
    "test:cv-list": "node --test scripts/cv-list-regression.test.mjs",
    "test:tab-labels": "node --test scripts/tab-label-visibility.test.mjs",
    "test:referral-utils": "tsx --test src/features/referrals/referral-management-utils.spec.ts",
    "test:freelancer-cv-filter-utils": "tsx --test src/features/freelancer/freelancer-cv-filter-utils.spec.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --config vite.injected.config.ts --mode amis-bridge && vite build --config vite.injected.config.ts --mode amis-page-hook"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@react-pdf/renderer": "^4.3.0",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-underline": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "^1.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}
