{
  "manifest_version": 3,
  "name": "VCS Recruitment Posting",
  "version": "0.1.0",
  "description": "Sync confirmed AMIS job snapshots to VCS Recruitment Core.",
  "action": {
    "default_title": "VCS Posting",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": ["activeTab", "alarms", "cookies", "debugger", "scripting", "storage", "tabs"],
  "host_permissions": [
    "http://localhost:3002/*",
    "http://localhost:4000/*",
    "http://localhost:4001/*",
    "https://quarry-judo-entail.ngrok-free.dev/*",
    "https://amisapp.misa.vn/*",
    "https://tuyendung.topcv.vn/*",
    "https://tuyendung-api.topcv.vn/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://localhost:4000/*", "http://localhost:4001/*"],
      "js": ["assets/frontend-bridge.js", "assets/amis-overlay.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://amisapp.misa.vn/*"],
      "js": ["assets/amis-overlay.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["side-panel.html", "assets/*"],
      "matches": [
        "https://amisapp.misa.vn/*",
        "http://localhost:4000/*",
        "http://localhost:4001/*"
      ]
    }
  ]
}
